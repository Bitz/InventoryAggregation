{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "InventoryApi": {
    "ApiKeyHeader": "X-Api-Key",
    "PageSize": 25,
    "MaxConcurrency": 4,
    "MaxRetries": 3,
    "BaseDelay": "00:00:00.200",
    "MaxRetryAfter": "00:00:10",
    "AttemptTimeout": "00:00:10",
    "PageTimeout": "00:00:30",
    "CollectionTimeout": "00:01:00",
    "PageRefetchLimit": 2,
    "CollectionAttempts": 2,
    "MaxPages": 1000,
    "InvalidRecordPolicy": "Report",
    "RateLimitPermits": 5,
    "RateLimitWindow": "00:00:10"
  }
}
